@page "/voluntariado"
@inject NavigationManager Navigation

<PageTitle>Voluntariado | Comunidad El Carmen</PageTitle>
<HeadContent>
    <meta name="description" content="Oportunidades de voluntariado en la Comunidad El Carmen." />
</HeadContent>

<Voluntariado OnContactRequested="NavigateToContact" />

@code {
    private Task NavigateToContact(string subject)
    {
        Navigation.NavigateTo($"/contacto?asunto={System.Uri.EscapeDataString(subject)}");
        return Task.CompletedTask;
    }
}
