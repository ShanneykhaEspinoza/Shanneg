<section id="emprendimientos" class="businesses section-observed section-padding" aria-labelledby="businesses-title">
    <div class="container">
        <div class="section-heading section-heading--light">
            <span class="section-kicker"><i class="fa-solid fa-store" aria-hidden="true"></i> Compra local</span>
            <h2 id="businesses-title">Talento de nuestra comunidad</h2>
            <p>Conoce y apoya a los emprendedores de El Carmen.</p>
        </div>

        <div class="business-carousel"
             role="region"
             aria-roledescription="carrusel"
             aria-label="Emprendimientos de la comunidad"
             @onpointerdown="StartSwipe"
             @onpointerup="EndSwipe">
            <div class="business-carousel__topbar">
                <p><strong>@VisibleRangeLabel</strong> de @Businesses.Length <span>Desliza o utiliza las flechas para explorar los emprendimientos</span></p>
            </div>

            <div class="business-carousel__viewport" aria-live="polite">
                <div class="business-carousel__cards">
                    @foreach (var business in VisibleBusinesses)
                    {
                        <article class="business-card community-card" @key="@(business.Name + "-" + CurrentPage)">
                            <div class="business-card__media">
                                <img src="@business.ImageUrl" alt="@business.ImageAlt" loading="lazy" width="720" height="480" draggable="false" />
                                <span class="business-card__category">@business.Category</span>
                            </div>
                            <div class="business-card__body">
                                <h3>@business.Name</h3>
                                <p>@business.Description</p>
                                <div class="business-card__owner"><span><i class="fa-regular fa-user" aria-hidden="true"></i> @business.Owner</span><span class="demo-chip">Local</span></div>
                                <div class="business-card__socials" aria-label="Contacto de @business.Name">
                                    <a href="#contacto" aria-label="Instagram"><i class="fa-brands fa-instagram" aria-hidden="true"></i></a>
                                    <a href="#contacto" aria-label="WhatsApp"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i></a>
                                    <button type="button" aria-label="Solicitar contacto con @business.Name" @onclick="RequestFairContact"><i class="fa-regular fa-envelope" aria-hidden="true"></i></button>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            </div>

            <div class="carousel-indicators" aria-label="Navegación del carrusel de emprendimientos">
                <button type="button" @onclick="Previous" aria-label="Mostrar emprendimiento anterior"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i></button>
                <button type="button" @onclick="Next" aria-label="Mostrar emprendimiento siguiente"><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
            </div>
        </div>

        <div class="section-cta section-cta--light">
            <div><strong>¿Tienes un emprendimiento?</strong><span>Muéstrale a la comunidad lo que haces.</span></div>
            <button class="button button--primary" type="button" @onclick="RequestFairContact"><i class="fa-solid fa-shop" aria-hidden="true"></i> Quiero participar en la próxima feria</button>
        </div>
    </div>
</section>

@code {
    [Parameter] public EventCallback<string> OnContactRequested { get; set; }

    private const int ItemsPerPage = 3;
    private int CurrentPage { get; set; }
    private double SwipeStartX { get; set; }
    private int PageCount => (int)Math.Ceiling(Businesses.Length / (double)ItemsPerPage);
    private int FirstVisibleItem => CurrentPage * ItemsPerPage + 1;
    private int LastVisibleItem => Math.Min(FirstVisibleItem + ItemsPerPage - 1, Businesses.Length);
    private string VisibleRangeLabel => FirstVisibleItem == LastVisibleItem ? FirstVisibleItem.ToString() : $"{FirstVisibleItem}-{LastVisibleItem}";

    private static readonly Business[] Businesses =
    [
        new("Café Senderos", "Café y repostería", "Café de origen y repostería artesanal preparados en pequeños lotes.", "María G.", "https://images.unsplash.com/photo-1453614512568-c4024d13c247?auto=format&fit=crop&w=1000&q=82", "Taza de café y preparación artesanal"),
        new("Cosecha Cercana", "Productos frescos", "Frutas, vegetales y hierbas cultivados por familias de la zona.", "Familia Rojas", "https://images.unsplash.com/photo-1542838132-92c53300491e?auto=format&fit=crop&w=1000&q=82", "Puesto con frutas y vegetales frescos"),
        new("Sabores de Casa", "Panadería", "Panes, galletas y recetas tradicionales para compartir en familia.", "Don Luis", "https://images.unsplash.com/photo-1509440159596-0249088772ff?auto=format&fit=crop&w=1000&q=82", "Panes artesanales recién preparados"),
        new("Esencia Verde", "Cuidado personal", "Jabones y productos de cuidado personal elaborados artesanalmente.", "Sofía M.", "https://images.unsplash.com/photo-1600857062241-98e5dba7f214?auto=format&fit=crop&w=1000&q=82", "Productos artesanales para el cuidado personal"),
        new("Hilo de Barrio", "Textiles", "Bolsos y accesorios textiles confeccionados con diseño y dedicación local.", "Ana C.", "https://images.unsplash.com/photo-1525507119028-ed4c629a60a3?auto=format&fit=crop&w=1000&q=82", "Prendas y textiles de un emprendimiento local"),
        new("Taller de Tejido", "Taller de tejer", "Clases y piezas tejidas a mano para aprender, compartir y crear en comunidad.", "Elena Vargas", "https://images.unsplash.com/photo-1452860606245-08befc0ff44b?auto=format&fit=crop&w=1000&q=82", "Materiales de colores para un taller de tejido")
    ];

    private IEnumerable<Business> VisibleBusinesses =>
        Businesses.Skip(CurrentPage * ItemsPerPage).Take(ItemsPerPage);

    private void Previous() => CurrentPage = (CurrentPage - 1 + PageCount) % PageCount;
    private void Next() => CurrentPage = (CurrentPage + 1) % PageCount;
    private void StartSwipe(PointerEventArgs args) => SwipeStartX = args.ClientX;

    private void EndSwipe(PointerEventArgs args)
    {
        var distance = args.ClientX - SwipeStartX;
        if (Math.Abs(distance) < 48)
        {
            return;
        }

        if (distance < 0)
        {
            Next();
        }
        else
        {
            Previous();
        }
    }

    private Task RequestFairContact() => OnContactRequested.InvokeAsync("Feria de emprendimiento");

    private sealed record Business(string Name, string Category, string Description, string Owner, string ImageUrl, string ImageAlt);
}
