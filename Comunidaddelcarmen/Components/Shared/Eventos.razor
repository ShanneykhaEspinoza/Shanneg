<section id="eventos" class="events section-observed section-padding" aria-labelledby="events-title">
    <div class="container">
        <div class="section-heading">
            <span class="section-kicker"><i class="fa-regular fa-calendar-check" aria-hidden="true"></i> Agenda comunitaria</span>
            <h2 id="events-title">Eventos de nuestra comunidad</h2>
            <p>Mantente informado sobre las próximas actividades de El Carmen.</p>
        </div>

        <div class="card-grid card-grid--three">
            @foreach (var communityEvent in CommunityEvents)
            {
                <article class="event-card community-card">
                    <div class="event-card__media">
                        <img src="@communityEvent.ImageUrl" alt="@communityEvent.ImageAlt" loading="lazy" width="720" height="480" />
                        <time class="date-badge" datetime="@communityEvent.Date.ToString("yyyy-MM-dd")">
                            <strong>@communityEvent.Date.Day</strong><span>@communityEvent.Date.ToString("MMM", SpanishCulture)</span>
                        </time>
                    </div>
                    <div class="event-card__body">
                        <span class="content-label">Actividad comunitaria</span>
                        <h3>@communityEvent.Name</h3>
                        <div class="event-card__meta">
                            <span><i class="fa-regular fa-clock" aria-hidden="true"></i> @communityEvent.Time</span>
                            <span><i class="fa-solid fa-location-dot" aria-hidden="true"></i> @communityEvent.Location</span>
                        </div>
                        <p>@communityEvent.Description</p>
                        @if (ExpandedEventId == communityEvent.Id)
                        {
                            <p class="event-card__detail" id="event-detail-@communityEvent.Id">@communityEvent.Detail</p>
                        }
                        <button class="text-button" type="button" aria-expanded="@(ExpandedEventId == communityEvent.Id)" aria-controls="event-detail-@communityEvent.Id" @onclick="() => ToggleDetails(communityEvent.Id)">
                            @(ExpandedEventId == communityEvent.Id ? "Ocultar detalles" : "Ver detalles") <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                        </button>
                    </div>
                </article>
            }
        </div>

        <div class="calendar-panel">
            <div class="calendar-panel__copy">
                <span class="section-kicker"><i class="fa-solid fa-calendar-days" aria-hidden="true"></i> Calendario</span>
                <h3>Organiza tu participación</h3>
                <p>Los días con un punto verde incluyen una actividad comunitaria programada.</p>
                <div class="calendar-legend">
                    <span><i class="legend-dot legend-dot--today" aria-hidden="true"></i> Hoy</span>
                    <span><i class="legend-dot legend-dot--event" aria-hidden="true"></i> Con evento</span>
                </div>
            </div>

            <div class="calendar" aria-label="Calendario comunitario interactivo">
                <div class="calendar__header">
                    <button type="button" @onclick="PreviousMonth" aria-label="Mostrar mes anterior"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button>
                    <h3 aria-live="polite">@MonthLabel</h3>
                    <button type="button" @onclick="NextMonth" aria-label="Mostrar mes siguiente"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
                </div>
                <div class="calendar__grid" role="grid" aria-label="@MonthLabel">
                    @foreach (var weekday in Weekdays)
                    {
                        <span class="calendar__weekday" role="columnheader">@weekday</span>
                    }
                    @foreach (var day in CalendarDays)
                    {
                        <button type="button"
                                class="calendar__day @(day.IsToday ? "is-today" : null) @(day.HasEvent ? "has-event" : null)"
                                disabled="@(!day.IsCurrentMonth)"
                                aria-label="@day.AccessibleLabel"
                                aria-current="@(day.IsToday ? "date" : null)">
                            <span>@day.Date.Day</span>
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly CultureInfo SpanishCulture = CultureInfo.GetCultureInfo("es-CR");
    private static readonly string[] Weekdays = ["Lun", "Mar", "Mié", "Jue", "Vie", "Sáb", "Dom"];
    private readonly List<CommunityEvent> CommunityEvents = [];
    private DateTime DisplayMonth { get; set; } = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private int? ExpandedEventId { get; set; }

    private string MonthLabel => DisplayMonth.ToString("MMMM yyyy", SpanishCulture);
    private IReadOnlyList<CalendarDay> CalendarDays => BuildCalendarDays();

    protected override void OnInitialized()
    {
        var month = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        CommunityEvents.AddRange(
        [
            new(1, month.AddDays(9), "9:00 a. m.", "Parque de la comunidad", "Jornada familiar en el parque", "Una mañana para compartir, jugar y fortalecer los lazos entre vecinos.", "Actividad abierta para todas las edades. Se recomienda llevar agua, protector solar y una manta.", "https://images.unsplash.com/photo-1511632765486-a01980e01a18?auto=format&fit=crop&w=1200&q=82", "Familias y vecinos compartiendo en una actividad al aire libre"),
            new(2, month.AddDays(16), "7:30 a. m.", "Salón comunal", "Caminata por El Carmen", "Recorrido recreativo para activar el cuerpo y encontrarnos como comunidad.", "El recorrido es de dificultad baja. Las personas menores de edad deben asistir acompañadas.", "https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1200&q=82", "Sendero rodeado de naturaleza para una caminata comunitaria"),
            new(3, month.AddDays(23), "4:00 p. m.", "Plaza de deportes", "Tarde cultural y recreativa", "Música, juegos y presentaciones de talento local para disfrutar en familia.", "La programación y los horarios deberán confirmarse con el comité organizador.", "https://images.unsplash.com/photo-1529156069898-49953e39b3ac?auto=format&fit=crop&w=1200&q=82", "Grupo de personas disfrutando una actividad comunitaria")
        ]);
    }

    private void ToggleDetails(int eventId) => ExpandedEventId = ExpandedEventId == eventId ? null : eventId;
    private void PreviousMonth() => DisplayMonth = DisplayMonth.AddMonths(-1);
    private void NextMonth() => DisplayMonth = DisplayMonth.AddMonths(1);

    private IReadOnlyList<CalendarDay> BuildCalendarDays()
    {
        var firstDay = new DateTime(DisplayMonth.Year, DisplayMonth.Month, 1);
        var mondayOffset = ((int)firstDay.DayOfWeek + 6) % 7;
        var gridStart = firstDay.AddDays(-mondayOffset);
        var eventDates = CommunityEvents.Select(item => item.Date.Date).ToHashSet();
        var days = new List<CalendarDay>(42);

        for (var index = 0; index < 42; index++)
        {
            var date = gridStart.AddDays(index);
            var isCurrentMonth = date.Month == DisplayMonth.Month && date.Year == DisplayMonth.Year;
            var isToday = date.Date == DateTime.Today;
            var hasEvent = eventDates.Contains(date.Date);
            var label = date.ToString("dddd d 'de' MMMM 'de' yyyy", SpanishCulture);
            if (hasEvent)
            {
                label += ", día con evento";
            }

            days.Add(new CalendarDay(date, isCurrentMonth, isToday, hasEvent, label));
        }

        return days;
    }

    private sealed record CommunityEvent(int Id, DateTime Date, string Time, string Location, string Name, string Description, string Detail, string ImageUrl, string ImageAlt);
    private sealed record CalendarDay(DateTime Date, bool IsCurrentMonth, bool IsToday, bool HasEvent, string AccessibleLabel);
}
