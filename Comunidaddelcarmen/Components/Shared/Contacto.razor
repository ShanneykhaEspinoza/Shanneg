<section id="contacto" class="contact section-observed section-padding" aria-labelledby="contact-title">
    <div class="container">
        <div class="section-heading">
            <span class="section-kicker"><i class="fa-regular fa-comments" aria-hidden="true"></i> Contacto</span>
            <h2 id="contact-title">Estamos para escucharte</h2>
            <p>Comparte una consulta, una idea o tu interés por participar.</p>
        </div>

        <div class="contact-layout">
            <aside class="contact-info" aria-label="Información de contacto">
                <span class="contact-info__eyebrow">Comunidad El Carmen</span>
                <h3>Conversemos sobre nuestra comunidad</h3>
                <p>Los siguientes datos son demostrativos y deberán reemplazarse por los canales oficiales del comité.</p>

                <address class="contact-details">
                    <div><i class="fa-solid fa-location-dot" aria-hidden="true"></i><span><small>Ubicación</small><strong>Río Segundo, Alajuela, Costa Rica</strong></span></div>
                    <div><i class="fa-solid fa-phone" aria-hidden="true"></i><span><small>Teléfono de demostración</small><strong>+506 0000-0000</strong></span></div>
                    <div><i class="fa-regular fa-envelope" aria-hidden="true"></i><span><small>Correo de demostración</small><a href="mailto:correo@ejemplo.com">correo@ejemplo.com</a></span></div>
                    <div><i class="fa-regular fa-clock" aria-hidden="true"></i><span><small>Horario demostrativo</small><strong>Lunes a viernes · 8:00 a. m. a 4:00 p. m.</strong></span></div>
                </address>

                <div class="contact-socials">
                    <span>Síguenos</span>
                    <div aria-label="Redes sociales de demostración">
                        <a href="#contacto" aria-label="Facebook de demostración"><i class="fa-brands fa-facebook-f" aria-hidden="true"></i></a>
                        <a href="#contacto" aria-label="Instagram de demostración"><i class="fa-brands fa-instagram" aria-hidden="true"></i></a>
                        <a href="#contacto" aria-label="WhatsApp de demostración"><i class="fa-brands fa-whatsapp" aria-hidden="true"></i></a>
                    </div>
                </div>
            </aside>

            <div class="contact-form-card">
                @if (FormSubmitted)
                {
                    <div class="form-success" role="status" tabindex="-1">
                        <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
                        <div><strong>¡Gracias por contactarnos!</strong><p>Hemos recibido tu mensaje.</p></div>
                    </div>
                }

                <EditForm Model="@Model" OnValidSubmit="HandleValidSubmit" FormName="community-contact" class="contact-form">
                    <DataAnnotationsValidator />
                    <div class="form-grid">
                        <div class="form-field">
                            <label for="contact-name">Nombre <span aria-hidden="true">*</span></label>
                            <InputText id="contact-name" @bind-Value="Model.Name" autocomplete="name" placeholder="Tu nombre completo" />
                            <ValidationMessage For="@(() => Model.Name)" />
                        </div>
                        <div class="form-field">
                            <label for="contact-email">Correo <span aria-hidden="true">*</span></label>
                            <InputText id="contact-email" @bind-Value="Model.Email" type="email" inputmode="email" autocomplete="email" placeholder="nombre@correo.com" />
                            <ValidationMessage For="@(() => Model.Email)" />
                        </div>
                        <div class="form-field">
                            <label for="contact-phone">Teléfono</label>
                            <InputText id="contact-phone" @bind-Value="Model.Phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="8888-8888" />
                            <ValidationMessage For="@(() => Model.Phone)" />
                        </div>
                        <div class="form-field">
                            <label for="contact-subject">Asunto <span aria-hidden="true">*</span></label>
                            <InputSelect id="contact-subject" @bind-Value="Model.Subject">
                                <option value="">Selecciona una opción</option>
                                @foreach (var subject in Subjects)
                                {
                                    <option value="@subject">@subject</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => Model.Subject)" />
                        </div>
                        <div class="form-field form-field--full">
                            <label for="contact-message">Mensaje <span aria-hidden="true">*</span></label>
                            <InputTextArea id="contact-message" @bind-Value="Model.Message" placeholder="Cuéntanos cómo podemos ayudarte" />
                            <ValidationMessage For="@(() => Model.Message)" />
                        </div>
                    </div>
                    <p class="form-note"><i class="fa-solid fa-shield-heart" aria-hidden="true"></i> Los campos con * son obligatorios. Este formulario es una demostración y no almacena datos.</p>
                    <button class="button button--primary button--full" type="submit"><i class="fa-regular fa-paper-plane" aria-hidden="true"></i> Enviar mensaje</button>
                </EditForm>
            </div>
        </div>
    </div>
</section>

@code {
    [Parameter] public string? InitialSubject { get; set; }
    [Parameter] public int SelectionVersion { get; set; }

    private static readonly string[] Subjects =
    [
        "Consulta general",
        "Eventos",
        "Voluntariado",
        "Talleres",
        "Reciclaje",
        "Feria de emprendimiento"
    ];

    private ContactFormModel Model { get; set; } = new();
    private bool FormSubmitted { get; set; }
    private int _lastSelectionVersion = -1;

    protected override void OnParametersSet()
    {
        if (SelectionVersion == _lastSelectionVersion || string.IsNullOrWhiteSpace(InitialSubject))
        {
            return;
        }

        _lastSelectionVersion = SelectionVersion;
        if (Subjects.Contains(InitialSubject))
        {
            Model.Subject = InitialSubject;
            FormSubmitted = false;
        }
    }

    private void HandleValidSubmit()
    {
        FormSubmitted = true;
        Model = new ContactFormModel();
    }

    private sealed class ContactFormModel
    {
        [Required(ErrorMessage = "Ingresa tu nombre.")]
        [MinLength(3, ErrorMessage = "El nombre debe tener al menos 3 caracteres.")]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "Ingresa tu correo.")]
        [EmailAddress(ErrorMessage = "Ingresa un correo con formato válido.")]
        public string Email { get; set; } = string.Empty;

        [Phone(ErrorMessage = "Ingresa un número de teléfono válido.")]
        public string? Phone { get; set; }

        [Required(ErrorMessage = "Selecciona un asunto.")]
        public string Subject { get; set; } = string.Empty;

        [Required(ErrorMessage = "Escribe un mensaje.")]
        [MinLength(10, ErrorMessage = "El mensaje debe tener al menos 10 caracteres.")]
        public string Message { get; set; } = string.Empty;
    }
}
